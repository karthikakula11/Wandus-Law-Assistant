# Copy to .env and fill in values. Never commit .env.

OPENAI_API_KEY=

# Optional overrides (defaults match text-embedding-3-small @ 1536 dims)
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# Chat model (general + RAG answer synthesis) — gpt-4o-mini recommended
# OPENAI_CHAT_MODEL=gpt-4o-mini
# EMBEDDING_DIMENSIONS=1536

# Postgres — use a long random password in production (e.g. openssl rand -hex 24)
POSTGRES_USER=postgres
POSTGRES_DB=lawchat
POSTGRES_PORT=5432
POSTGRES_PASSWORD=change-me-to-a-long-random-secret

# Must match user, password, host, port, database above (URL-encode special chars in password)
DATABASE_URL=postgresql://postgres:change-me-to-a-long-random-secret@localhost:5432/lawchat

# OpenSearch (BM25 leg for hybrid RAG). Leave unset for dense-only + no ingest indexing to search.
# Local: docker compose up -d opensearch  →  http://localhost:9200
# OPENSEARCH_URL=http://localhost:9200

# Hybrid RAG: BM25 + dense vectors + RRF (requires OPENSEARCH_URL for lexical leg)
# HYBRID_RAG_ENABLED=false
# BM25_ENABLED=true
# RRF_K=60
# HYBRID_PER_LIST_CAP=50

# Jam-style native hybrid in OpenSearch (BM25 + kNN + RRF pipeline). Requires OPENSEARCH_URL.
# Use a fresh index name, restart API (creates index + pipeline), then re-ingest all documents.
# OPENSEARCH_UNIFIED_HYBRID=false
# OPENSEARCH_INDEX_NAME=law_chunks_unified

# LangGraph agentic RAG (plan → retrieve → grade → optional rewrite/re-retrieve → optional broaden → generate). On by default.
# USE_LANGGRAPH_AGENT=true
# RAG_AGENTIC_GRADE_ENABLED=true
# RAG_AGENT_MAX_REWRITE_ROUNDS=2

# Multi-upload routing (embedding shortlist; scales to large libraries — no per-doc LLM list)
# DOCUMENT_ROUTER_ENABLED=true
# DOCUMENT_ROUTER_POOL_CHUNKS=500
# DOCUMENT_ROUTER_MAX_CANDIDATE_DOCS=250

# Langfuse (optional): SDK tracing (Jam-style). View tokens/cost in the Langfuse web app, not via a metrics API here.
# When set, OpenAI calls use the Langfuse-wrapped client. The in-app Usage screen links to your Langfuse dashboard.
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_SECRET_KEY=sk-lf-...
# API base (defaults to cloud). Langfuse SDK accepts LANGFUSE_BASE_URL or LANGFUSE_HOST.
# LANGFUSE_BASE_URL=https://cloud.langfuse.com
# Hours between refreshes of local cost rates from GET /api/public/models (LLMUsageLog).
# LANGFUSE_PRICING_REFRESH_HOURS=6
# Optional: POST duplicate generations to /api/public/ingestion (usually leave false — SDK already traces).
# LANGFUSE_MANUAL_INGESTION=false

# Retrieval drift (KS on live confidence samples). Lower = faster to get badges in demos.
# DRIFT_MIN_SAMPLES=5
# DRIFT_SPLIT_MIN_TOTAL=10
